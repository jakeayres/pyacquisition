{#- A class's members. A driver whose methods have groups (see _groups.html.jinja)
    lists them under a heading for each group, in the order of the code, so a
    setting's query and command sit together. Anything else is as mkdocstrings
    lists it. -#}

{% import "_groups.html.jinja" as groups with context %}

{% set members_list = config.members if root_members else none %}
{% set functions = (obj.functions if obj.is_class else {})
    | filter_objects(
      filters=config.filters,
      members_list=members_list,
      inherited_members=config.inherited_members,
      keep_no_docstrings=config.show_if_no_docstring,
    )
    | order_members("source", members_list) %}
{% if config.merge_init_into_class %}
  {% set functions = functions | rejectattr("name", "eq", "__init__") | list %}
{% endif %}
{% set names = groups.group_names(functions) | trim %}

{% if not names %}
  {% include "_base/children.html.jinja" with context %}
{% else %}
  <div class="doc doc-children">
    {% for attribute in obj.attributes
        | filter_objects(
          filters=config.filters,
          members_list=members_list,
          inherited_members=config.inherited_members,
          keep_no_docstrings=config.show_if_no_docstring,
        )
        | order_members(config.members_order, members_list) %}
      {% include attribute|get_template with context %}
    {% endfor %}

    {% for group in names.split("\n") %}
      {% filter heading(heading_level, id=groups.group_id(group), toc_label=group, skip_inventory=true, class="pa-method-group") %}{{ group }}{% endfilter %}
      {% with heading_level = heading_level + 1 %}
        {% for function in functions %}
          {% if groups.in_group(function, group) %}
            {% include function|get_template with context %}
          {% endif %}
        {% endfor %}
      {% endwith %}
    {% endfor %}
  </div>
{% endif %}
